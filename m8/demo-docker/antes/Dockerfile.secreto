# ANTES (escenario K4): dos formas comunes de filtrar un secreto en la imagen.
# Version corregida: despues/Dockerfile.secreto.
#   docker build --build-arg NPM_TOKEN=... -f antes/Dockerfile.secreto api
# 1) ARG con el token: el valor queda escrito en el historial de la imagen
#    (docker history muestra cada RUN con NPM_TOKEN=...).
# 2) COPY .env y luego RUN rm .env: el archivo ya quedo en una capa anterior;
#    borrarlo en otra capa solo lo oculta, cualquiera con la imagen lo extrae.
# 3) Sin .dockerignore (antes/Dockerfile.secreto.dockerignore esta vacio), asi
#    que .env entra en el contexto de build.
# npmrc.k4 apunta a un registro privado ficticio y lee ${NPM_TOKEN} del entorno.
FROM node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205
ARG NPM_TOKEN
WORKDIR /app
COPY package.json package-lock.json ./
COPY npmrc.k4 ./.npmrc
RUN npm ci --omit=dev --ignore-scripts && rm .npmrc
COPY .env ./
RUN echo "configuracion leida" && rm .env
USER node
CMD ["node", "-e", "console.log('demo K4')"]
