# DESPUES (escenario K4): el token nunca entra en la imagen.
# Version sin corregir: antes/Dockerfile.secreto.
#   NPM_TOKEN=... docker build --secret id=npm_token,env=NPM_TOKEN -f despues/Dockerfile.secreto api
# CORRECCIÓN: despues/Dockerfile.secreto.dockerignore excluye .env: lo que no
# entra al contexto de build no puede terminar en la imagen.
FROM docker.io/library/node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205
# CORRECCIÓN: sin ARG NPM_TOKEN. Un ARG queda en el historial de la imagen.
WORKDIR /app
COPY package.json package-lock.json ./
COPY npmrc.k4 ./.npmrc
# CORRECCIÓN: --mount=type=secret monta el token solo durante este RUN (aqui
# como variable de entorno, env=). No queda en ninguna capa ni en el historial
# (K4: 0 hallazgos frente a 3 en la version de antes/). .npmrc se borra en el
# MISMO RUN, asi tampoco queda en una capa.
RUN --mount=type=secret,id=npm_token,env=NPM_TOKEN npm ci --omit=dev --ignore-scripts && rm .npmrc
# CORRECCIÓN: sin COPY .env. La configuracion y las claves de la aplicacion
# (PGPASSWORD...) llegan al contenedor al ejecutarlo (Compose, orquestador),
# nunca dentro de la imagen.
USER node
CMD ["node", "-e", "console.log('demo K4')"]
