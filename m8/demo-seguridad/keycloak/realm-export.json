{
  "realm": "demo",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "customer", "description": "Usuario final que tiene pedidos" }
    ]
  },
  "clients": [
    {
      "clientId": "spa-demo",
      "name": "SPA de demo (authorization code + PKCE)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://127.0.0.1:18610/callback"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "orders-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "orders-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "demo-cli",
      "name": "Cliente de línea de comandos (direct grants, solo para los scripts de medición)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "orders-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "orders-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "demo-noaud",
      "name": "Cliente sin audience mapper (para el escenario SB: token sin aud=orders-api)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "demo-short",
      "name": "Cliente con access token de 1 s (para el escenario SB: token expirado real)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "attributes": { "access.token.lifespan": "1" },
      "protocolMappers": [
        {
          "name": "orders-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "orders-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "api",
      "name": "Servicio api (confidencial, client credentials para llamar a precios)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "api-secret-demo-solo-clase",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "precios-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "precios-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "00000000-0000-4000-8000-0000000a11ce",
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "email": "alice@demo.local",
      "firstName": "Alice",
      "lastName": "A",
      "credentials": [{ "type": "password", "value": "alice123", "temporary": false }],
      "realmRoles": ["customer"]
    },
    {
      "id": "00000000-0000-4000-8000-000000000b0b",
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "email": "bob@demo.local",
      "firstName": "Bob",
      "lastName": "B",
      "credentials": [{ "type": "password", "value": "bob123", "temporary": false }],
      "realmRoles": ["customer"]
    }
  ]
}
