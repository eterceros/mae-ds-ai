<?xml version="1.0" encoding="UTF-8"?>
<!-- M10: Flyway aplica las migraciones versionadas de src/main/resources/db/migration.
     Uso (con la base de la demo levantada): mvn -q flyway:migrate flyway:info
     La URL se puede cambiar con -Dflyway.url=... -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>m8.demo</groupId>
  <artifactId>flyway-renombre</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <properties>
    <flyway.version>13.11.1</flyway.version>
    <flyway.url>jdbc:postgresql://127.0.0.1:18543/orm_flyway</flyway.url>
    <flyway.user>demo</flyway.user>
    <flyway.password>demo</flyway.password>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.flywaydb</groupId>
        <artifactId>flyway-maven-plugin</artifactId>
        <version>${flyway.version}</version>
        <configuration>
          <locations>
            <location>filesystem:src/main/resources/db/migration</location>
          </locations>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <version>${flyway.version}</version>
          </dependency>
          <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.14</version>
          </dependency>
        </dependencies>
      </plugin>
    </plugins>
  </build>
</project>
